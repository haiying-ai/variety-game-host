.page {
  padding-top: 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  font-size: var(--fs-xs);
  color: var(--c-accent);
  letter-spacing: 2rpx;
}

.game-title {
  margin-top: 10rpx;
  font-size: var(--fs-2xl);
  font-weight: bold;
  line-height: 1.35;
}
.game-style {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--c-ink-2);
  line-height: 1.7;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.meta {
  margin-top: 14rpx;
  font-size: var(--fs-sm);
  color: var(--c-ink-2);
  line-height: 1.7;
}
.meta-k {
  display: inline-block;
  min-width: 88rpx;
  margin-right: 16rpx;
  font-size: var(--fs-xs);
  color: var(--c-ink-3);
}

.section-title {
  font-size: var(--fs-xs);
  font-weight: bold;
  color: var(--c-accent);
  letter-spacing: 3rpx;
  margin-bottom: 20rpx;
}

/* ===== 名场面：左侧金线引用块 + 极淡暖金光晕 ===== */
.scene-card {
  background: var(--c-sub);
  background-image: radial-gradient(140% 100% at 0% 0%, rgba(216, 164, 92, 0.10), transparent 62%);
  border-left: 4rpx solid var(--c-accent);
}
.scene-src {
  margin-top: 8rpx;
  font-size: var(--fs-xs);
  color: var(--c-ink-3);
}
.scene-text {
  margin-top: 16rpx;
  font-size: var(--fs-md);
  line-height: 1.8;
  color: var(--c-ink);
}

/* ===== 玩法步骤 ===== */
.goal-line {
  font-size: var(--fs-lg);
  font-weight: bold;
  color: var(--c-ink);
  line-height: 1.55;
  margin-bottom: 8rpx;
}
.step-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--c-line);
}
.step-no {
  flex: none;
  width: 44rpx;
  font-size: var(--fs-md);
  font-weight: bold;
  color: var(--c-accent);
  line-height: 1.7;
}
.step-txt {
  flex: 1;
  font-size: var(--fs-md);
  line-height: 1.75;
  color: var(--c-ink);
}
.howto-line {
  margin-top: 18rpx;
  font-size: var(--fs-sm);
  color: var(--c-ink-2);
  line-height: 1.8;
}
.content-tip {
  margin-top: 18rpx;
  font-size: var(--fs-xs);
  color: var(--c-teal);
  background: rgba(111, 208, 166, 0.10);
  border: 1rpx solid rgba(111, 208, 166, 0.26);
  border-radius: var(--r-inner);
  padding: 16rpx 18rpx;
  line-height: 1.7;
}

/* ===== 人数设置 ===== */
.stepper-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 4rpx 0 20rpx;
}
.stepper-label {
  font-size: var(--fs-md);
  color: var(--c-ink);
}
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 84rpx;
  height: 84rpx;
  background: var(--c-sub);
  border: 1rpx solid var(--c-line);
  color: var(--c-accent);
  font-size: var(--fs-2xl);
  border-radius: var(--r-inner);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.step-num {
  min-width: 104rpx;
  text-align: center;
  font-size: var(--fs-2xl);
  font-weight: bold;
}

.role-preview {
  background: var(--c-sub);
  border-radius: var(--r-inner);
  padding: 18rpx 20rpx;
  font-size: var(--fs-sm);
  color: var(--c-ink-2);
  line-height: 1.7;
}

.host-hint {
  margin-top: 16rpx;
  background: var(--c-sub);
  border-left: 3rpx solid var(--c-line);
  border-radius: var(--r-inner);
  padding: 16rpx 18rpx;
  font-size: var(--fs-xs);
  color: var(--c-ink-3);
  line-height: 1.75;
}
