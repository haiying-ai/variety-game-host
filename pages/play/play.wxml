<view class="page">

  <!-- ===== 设置阶段：主持人模式说明 + 玩家名单 ===== -->
  <block wx:if="{{stage === 'setup'}}">
    <view class="card">
      <view class="section-title">主持人模式</view>
      <view class="host-line"><text class="host-no">1</text><text class="host-txt">手机全程拿在主持人手里，不用传给玩家</text></view>
      <view class="host-line"><text class="host-no">2</text><text class="host-txt">主持人不参加游戏，负责发身份、带节奏、记分</text></view>
      <view class="host-line"><text class="host-no">3</text><text class="host-txt">身份和词语只有主持人能看，由主持人口头引导大家玩</text></view>
    </view>

    <view class="card">
      <view class="section-title">本局目标</view>
      <view class="goal-line">{{goal}}</view>
      <view class="howto-line">{{howto}}</view>
      <view class="role-preview" wx:if="{{rolePreview}}"><text>{{rolePreview}}</text></view>
    </view>

    <view class="card">
      <view class="section-title">玩家名单（可以改成真名）</view>
      <view class="name-row" wx:for="{{nameInputs}}" wx:for-item="p" wx:for-index="idx" wx:key="idx">
        <text class="name-idx">{{idx + 1}}</text>
        <input class="name-input" value="{{p.value}}" bindinput="onNameInput" data-i="{{idx}}" placeholder="玩家{{idx + 1}}" placeholder-class="ph" />
      </view>
    </view>

    <view class="btn-main" hover-class="press-deep" bindtap="startGame">发身份 · 开始游戏</view>
    <view class="btn-back" bindtap="goBack">‹ 换个游戏 / 调整人数</view>
  </block>

  <!-- ===== 游戏阶段 ===== -->
  <block wx:if="{{stage === 'play'}}">
    <view class="host-badge">主持人专用屏 · {{gameName}}</view>

    <!-- 出题中 -->
    <view class="card center-card" wx:if="{{preparing}}">
      <view class="round-title">正在出题</view>
      <view class="round-sub">每组题只向 AI 要一次，后面的局会直接出，不用等</view>
    </view>

    <block wx:if="{{!preparing}}">

    <!-- 身份类：主持人控制台 -->
    <block wx:if="{{mode === 'cards'}}">
      <view class="card">
        <view class="round-title">{{round.title}}</view>
        <view class="round-headline">{{round.headline}}</view>
      </view>

      <view class="card secret-card">
        <view class="section-title">仅主持人可见</view>
        <view class="secret-line" wx:for="{{secretSummary}}" wx:key="*this">{{item}}</view>
      </view>

      <view class="card">
        <view class="section-title">身份总览<text class="ov-tip">（点一下标记出局）</text></view>
        <view class="pl-row {{p.out ? 'pl-out' : ''}}" wx:for="{{players}}" wx:for-item="p" wx:for-index="idx" wx:key="idx"
              hover-class="press" bindtap="toggleOut" data-i="{{idx}}">
          <text class="pl-name">{{idx + 1}}. {{p.name}}</text>
          <text class="pl-role {{p.secret === '狼人' ? 'pl-wolf' : ''}}">{{p.out ? '已出局 · ' : ''}}{{p.secret}}</text>
        </view>
      </view>

      <view class="card">
        <view class="section-title">带节奏（第 {{stepIndex + 1}} / {{steps.length}} 步）</view>
        <view class="step-text">{{steps[stepIndex]}}</view>
        <view class="word-btns">
          <view class="word-btn" hover-class="press-deep" bindtap="prevStep">‹ 上一步</view>
          <view class="word-btn" hover-class="press-deep" bindtap="nextStep">下一步 ›</view>
        </view>
      </view>
    </block>

    <!-- 猜词类：主持人翻词给比划的人 -->
    <block wx:elif="{{mode === 'words'}}">
      <view class="card center-card">
        <view class="round-title">{{round.title}}</view>
        <view class="word-cat">{{round.words[wordIndex].cat}}</view>
        <view class="big-word {{tick % 2 ? 'pop-a' : 'pop-b'}}">{{round.words[wordIndex].word}}</view>
        <view class="hint-text">主持人念给比划的人听，或把手机转过去看一眼。第 {{wordIndex + 1}} / {{round.words.length}} 个词</view>
        <view class="word-btns">
          <view class="word-btn" hover-class="press-deep" bindtap="prevWord">‹ 上一个</view>
          <view class="word-btn" hover-class="press-deep" bindtap="nextWord">下一个 ›</view>
        </view>
      </view>
    </block>

    <!-- 数字炸弹：只有主持人看数字 -->
    <block wx:elif="{{mode === 'number'}}">
      <view class="card center-card">
        <view class="round-title">{{round.title}}</view>
        <view class="round-headline">{{round.headline}}</view>
        <block wx:if="{{!revealed}}">
          <view class="btn-main" hover-class="press-deep" bindtap="revealCard">点我看炸弹数字（仅主持人）</view>
        </block>
        <block wx:else>
          <view class="secret {{tick % 2 ? 'pop-a' : 'pop-b'}}">{{round.bomb}}</view>
          <view class="secret-tip">谁猜中这个数，主持人宣布惩罚：{{round.penalty}}</view>
          <view class="btn-main" hover-class="press-deep" bindtap="reshuffle">换一个数字</view>
        </block>
      </view>
    </block>

    <!-- 真心话大冒险：主持人抽题念出来 -->
    <block wx:elif="{{mode === 'truthdare'}}">
      <view class="card center-card">
        <view class="round-title">{{round.title}}</view>
        <view class="round-headline">被点到的玩家选一个，主持人念题目</view>
        <block wx:if="{{!tdText}}">
          <view class="word-btns">
            <view class="word-btn" hover-class="press-deep" bindtap="drawTruth">真心话</view>
            <view class="word-btn" hover-class="press-deep" bindtap="drawDare">大冒险</view>
          </view>
        </block>
        <block wx:else>
          <view class="secret {{tick % 2 ? 'pop-a' : 'pop-b'}}">{{tdText}}</view>
          <view class="word-btns">
            <view class="word-btn" hover-class="press-deep" bindtap="drawTruth">换真心话</view>
            <view class="word-btn" hover-class="press-deep" bindtap="drawDare">换大冒险</view>
          </view>
        </block>
      </view>
    </block>

    <!-- 一条内容类：主持人展示 -->
    <block wx:elif="{{mode === 'single'}}">
      <view class="card center-card">
        <view class="round-title">{{round.title}}</view>
        <view class="round-label" wx:if="{{round.label}}">{{round.label}}</view>
        <view class="big-word small {{tick % 2 ? 'pop-a' : 'pop-b'}}">{{round.word}}</view>
        <view class="round-sub" wx:if="{{round.sub}}">{{round.sub}}</view>
        <block wx:if="{{round.extras && round.extras.length}}">
          <view class="section-title-left">仅主持人可见</view>
          <view class="extra" wx:for="{{round.extras}}" wx:key="*this">{{item}}</view>
        </block>
        <view class="src-tag">{{round.source}}</view>
        <view class="btn-main" hover-class="press-deep" bindtap="reshuffle">换一个</view>
      </view>
    </block>

    <!-- 自由发挥 -->
    <block wx:elif="{{mode === 'free'}}">
      <view class="card center-card">
        <view class="round-title">{{round.title}}</view>
        <view class="round-headline">{{round.headline}}</view>
      </view>
    </block>

    </block>

    <!-- 计分板 -->
    <view class="card">
      <view class="section-title">{{isGroup ? '两队积分板（主持人记分）' : '积分板（主持人记分）'}}</view>
      <view class="score-row" wx:for="{{scores}}" wx:key="name" wx:for-item="s">
        <text class="score-name">{{s.name}}</text>
        <view class="score-ctrl">
          <view class="score-btn minus" hover-class="press-deep" catchtap="changeScore" data-i="{{index}}" data-d="-1">−</view>
          <text class="score-num">{{s.score}}</text>
          <view class="score-btn plus" hover-class="press-deep" catchtap="changeScore" data-i="{{index}}" data-d="1">＋</view>
        </view>
      </view>
    </view>

    <!-- 下一局 -->
    <view class="btn-main" hover-class="press-deep" bindtap="nextRound">生成下一局</view>
    <view class="btn-back" bindtap="goBack">‹ 换个游戏 / 调整人数</view>
  </block>

  <view style="height: 40rpx;"></view>
</view>
